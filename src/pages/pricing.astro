---
import Layout from '~/layouts/PageLayout.astro';
import EcosystemVendorBadge from '~/components/widgets/EcosystemVendorBadge.astro';

import pricing from '~/data/pricing.json';
import geoHooks from '~/data/geo-hooks.json';

const { tiers, footnote } = pricing;
const [core, guard] = tiers;

// Disambiguate the Guard tier's "Everything in Meridian" line on the card:
// "Meridian" is the brand, "Meridian Core" is the tier the user sees in the other column.
const guardFeatures = guard.features.map((f) => (f === 'Everything in Meridian' ? `Everything in ${core.name}` : f));

const usd = (n: number) => n.toFixed(2);

// SEO description — sharpened toward the superset positioning, kept price- and keyword-rich.
const pricingPageDescription = `Meridian is the complete risk manager for serious futures traders — every limit a traditional risk tool has, plus real-time behavioral detection. Native in NinjaTrader 8; Tradovate & Ironbeam apps in early access, one license. Core: free, no card. Guard: $${usd(guard.price)}/mo, cancel anytime. Trading involves substantial risk.`;

const metadata = {
  title: 'Pricing — Meridian Risk Management for Futures Traders',
  ignoreTitleTemplate: true,
  description: pricingPageDescription,
};

// Core is free (price 0, no billing period); Guard is billed monthly.
function tierToPricingPageOffers(tier: (typeof tiers)[number]) {
  const price = usd(tier.price);
  if (tier.price === 0) {
    return [{ '@type': 'Offer', name: `${tier.name} — free`, price, priceCurrency: tier.currency }];
  }
  return [
    {
      '@type': 'Offer',
      name: `${tier.name} — monthly`,
      price,
      priceCurrency: tier.currency,
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price,
        priceCurrency: tier.currency,
        billingDuration: 'P1M',
      },
    },
  ];
}

const pricingPageJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: 'Pricing — Meridian',
      url: 'https://www.meridianpsi.com/pricing',
      description: pricingPageDescription,
    },
    {
      '@type': 'SoftwareApplication',
      name: core.name,
      url: 'https://www.meridianpsi.com/pricing',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Windows',
      keywords: geoHooks.faqMetaExtra,
      offers: tierToPricingPageOffers(core),
    },
    {
      '@type': 'SoftwareApplication',
      name: guard.name,
      url: 'https://www.meridianpsi.com/pricing',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Windows',
      keywords: geoHooks.faqMetaExtra,
      offers: tierToPricingPageOffers(guard),
    },
  ],
}).replace(/</g, '\\u003c');

// Objection-handling FAQ — kept short and concrete at the wallet moment.
const faqs = [
  {
    q: 'Is Meridian Core really free?',
    a: 'Yes. Core costs nothing, needs no card, and has no trial countdown. Check out on Whop with your email, copy the license key, paste it into Meridian, and the full monitor and Intel workspace switch on.',
  },
  {
    q: 'When am I charged?',
    a: `Only if you buy Guard. Guard is $${usd(guard.price)} a month, charged the day you subscribe and monthly after that. Core is never charged.`,
  },
  {
    q: 'Can I cancel anytime?',
    a: 'Yes. Cancel Guard whenever you like and you keep it through the end of the period you have already paid for; your free Core license keeps working. Manage it yourself from the Account page (top right of this site) using your checkout email.',
  },
  {
    q: 'Core or Guard — which do I need?',
    a: 'Core is the full real-time monitor plus analytics: the live PSI score, all seven behavioral signals, 5-year session history, and the complete Intel workspace. Guard adds the enforcement layer on top — rules that enforce themselves (6 triggers · 5 action levels) and Strict Lock. Choose Guard if you want the tool to step in when you are tilting: it blocks you from adding risk (you can always exit) and never closes positions for you unless you turn that on. Start on Core and add Guard whenever you want it.',
  },
  {
    q: 'Do I need NinjaTrader 8?',
    a: 'Not necessarily. Meridian runs today as a native NinjaTrader 8 add-on — inside the platform, no separate login account. Standalone Meridian apps that connect directly to Tradovate and Ironbeam accounts are in early access and downloadable now; if you trade through one of those, download the app from the Platforms or Download page — the same free Core license activates it.',
  },
  {
    q: 'Do I pay more for Tradovate or Ironbeam?',
    a: 'No. One license covers every platform we support. NinjaTrader 8 is available now; the Tradovate and Ironbeam apps are in early access and included in the same license as they roll out.',
  },
  {
    q: 'How does the price compare to buying a risk tool, a journal, and an analytics app separately?',
    a: `Many traders pay for three separate subscriptions: a risk/lockout tool, a journaling app, and a stats/analytics platform. Meridian covers all three. The in-session journal that compiles with your fills and PSI score, and the Intel analytics workspace, come free with Core, on top of the behavioral layer no standalone risk tool has. Risk enforcement (Guard) is $${usd(guard.price)} a month. One Meridian license replaces the stack for less.`,
  },
  {
    q: 'Does Meridian place trades for me?',
    a: 'No. Meridian never opens a position and never provides signals. The only orders it ever touches are the ones its Guard rules act on — cancelling a new entry or flattening a position — and only under rules you configured in advance. Exits and protective stops are never blocked.',
  },
  {
    q: 'Can I override a lock mid-session?',
    a: 'Standard Guard responses are configurable — you choose how firm each trigger is, from a quiet alert to a typed acknowledgment to an entry block. Strict Lock is the exception by design: once armed for a window, you cannot switch it off mid-session — no early exit, no force-reset. You set it when you are calm, for the moment the tilted version of you wants to switch it off.',
  },
  {
    q: 'Does Meridian see my account credentials or funds?',
    a: 'The NinjaTrader 8 add-on reads execution data inside the platform — your broker credentials never touch Meridian. The standalone early-access apps sign in to your own account locally on your PC; credentials are used to open your session and are never transmitted to us. Meridian never holds, moves, or has any access to funds.',
  },
];
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={pricingPageJsonLd} />

  <!-- ───────────────────────── HERO ─────────────────────────
       Kept to three lines on purpose: people who click "Pricing" came for the
       number. The price cards must crest into the first viewport — the
       how-to-try pitch lives once, in THE RISK IS OURS section below. -->
  <section class="halo">
    <div data-reveal class="max-w-3xl mx-auto px-6 pt-12 md:pt-14 pb-4 text-center">
      <p class="eyebrow text-[11px] font-bold text-emerald-700 mb-4">PRICING</p>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-zinc-900 leading-[1.06]">
        Core is free. Guard is ${usd(guard.price)} a month.
      </h1>
      <p class="mt-4 max-w-2xl mx-auto text-lg text-zinc-600 leading-relaxed">
        The full monitor and Intel workspace cost nothing and need no card. Guard adds rules that enforce themselves.
      </p>
    </div>
  </section>

  <!-- ───────────────────────── PLANS ───────────────────────── -->
  <section class="border-y border-zinc-200 bg-white">
    <div data-reveal class="max-w-5xl mx-auto px-6 pt-10 pb-24">
      <div class="grid md:grid-cols-2 gap-6 items-start max-w-4xl mx-auto">
        <!-- Meridian Core -->
        <div class="rounded-2xl border border-zinc-200 bg-[#fafafa] p-8">
          <div class="mb-5">
            <h2 class="text-xl font-bold text-zinc-900">{core.name}</h2>
            <p class="mt-1 text-sm text-zinc-600">{core.description}</p>
          </div>

          <div class="mb-6 min-h-[88px]">
            <div class="flex items-baseline gap-1.5">
              <span class="text-5xl font-extrabold text-zinc-900 tnum">{core.priceLabel}</span>
            </div>
            <p class="text-xs text-zinc-500 mt-2">{core.priceNote}</p>
          </div>

          <a
            href={core.ctaHref}
            target="_blank"
            rel="noopener"
            class="block w-full text-center font-semibold text-zinc-900 bg-white border border-zinc-300 hover:border-zinc-400 px-6 py-3.5 rounded-xl transition mb-7"
          >
            {core.ctaText}
          </a>

          <ul class="space-y-3">
            {
              core.features.map((f) => (
                <li class="flex items-start gap-2.5 text-sm text-zinc-700">
                  <svg
                    class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  {f}
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Meridian Guard (recommended) -->
        <div class="rounded-2xl border-2 border-emerald-500 bg-white p-8 relative shadow-sm">
          <div
            class="absolute -top-3 left-8 text-[11px] font-bold text-white bg-emerald-600 px-2.5 py-1 rounded-full tracking-wide"
          >
            RECOMMENDED
          </div>
          <div class="mb-5">
            <h2 class="text-xl font-bold text-zinc-900">{guard.name}</h2>
            <p class="mt-1 text-sm text-zinc-600">{guard.description}</p>
          </div>

          <div class="mb-6 min-h-[88px]">
            <div class="flex items-baseline gap-1.5">
              <span class="text-5xl font-extrabold text-zinc-900 tnum">{guard.priceLabel}</span>
              <span class="text-zinc-500 text-sm">/month</span>
            </div>
            <p class="text-xs text-zinc-500 mt-2">{guard.priceNote}</p>
          </div>

          <a
            href={guard.ctaHref}
            target="_blank"
            rel="noopener"
            class="block w-full text-center font-semibold text-white bg-emerald-600 hover:bg-emerald-700 px-6 py-3.5 rounded-xl transition shadow-sm mb-7"
          >
            {guard.ctaText}
          </a>

          <ul class="space-y-3">
            {
              guardFeatures.map((f) => (
                <li class="flex items-start gap-2.5 text-sm text-zinc-700">
                  <svg
                    class="w-4 h-4 text-emerald-500 shrink-0 mt-0.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  {f}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- Trust strip -->
      <div
        class="mt-10 flex flex-wrap items-center justify-center gap-x-7 gap-y-2 text-xs text-zinc-500 max-w-3xl mx-auto"
      >
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg
          >
          Checkout secured by Whop
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg
          >
          Native NT8 add-on &middot; Tradovate &amp; Ironbeam apps in early access
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"
            ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg
          >
          Local-first — never your name, broker credentials, account numbers, or funds
        </span>
      </div>

      <div class="mt-6 flex justify-center">
        <EcosystemVendorBadge variant="compact" />
      </div>
    </div>
  </section>

  <!-- ───────────────────────── WHAT YOU'RE BUYING (superset) ───────────────────────── -->
  <section class="max-w-5xl mx-auto px-6 py-24">
    <div data-reveal class="text-center mb-12">
      <p class="eyebrow text-[11px] font-bold text-emerald-700 mb-3">WHAT EVERY PLAN INCLUDES</p>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-zinc-900">
        Acts before the order, not after the loss.
      </h2>
      <p class="mt-4 text-lg text-zinc-600 max-w-2xl mx-auto leading-relaxed">
        Every risk tool reacts after the loss. Meridian acts before the order &mdash; real-time behavioral detection
        that stops the mistake first. It still enforces every limit a traditional tool has: daily loss, P&amp;L,
        drawdown, streak cutoffs. And the journal plus analytics you'd otherwise buy separately &mdash; all in one plan.
      </p>
    </div>
    <div data-reveal class="grid md:grid-cols-2 gap-5 max-w-4xl mx-auto">
      <div class="rounded-2xl border border-zinc-200 bg-white p-7">
        <div class="text-sm font-semibold text-zinc-500 mb-4">What every risk tool does</div>
        <ul class="space-y-3 text-zinc-700">
          <li class="flex gap-3"><span class="text-zinc-400">&check;</span><span>Daily loss limit</span></li>
          <li class="flex gap-3"><span class="text-zinc-400">&check;</span><span>Single-trade loss cap</span></li>
          <li class="flex gap-3"><span class="text-zinc-400">&check;</span><span>P&amp;L / drawdown caps</span></li>
          <li class="flex gap-3"><span class="text-zinc-400">&check;</span><span>Loss-streak cutoff</span></li>
        </ul>
        <p class="mt-5 text-sm text-zinc-500">Included in both plans.</p>
      </div>
      <div class="rounded-2xl border-2 border-emerald-500 bg-emerald-50/40 p-7">
        <div class="text-sm font-semibold text-emerald-700 mb-4">What only Meridian adds</div>
        <ul class="space-y-3 text-zinc-800">
          <li class="flex gap-3">
            <span class="text-emerald-600 font-bold">&check;</span><span
              >Real-time <strong>behavior</strong> detection — 7 signals (revenge, oversizing, tilt&hellip;)</span
            >
          </li>
          <li class="flex gap-3">
            <span class="text-emerald-600 font-bold">&check;</span><span
              >A baseline that learns how <em>you</em> trade — not a generic average</span
            >
          </li>
          <li class="flex gap-3">
            <span class="text-emerald-600 font-bold">&check;</span><span
              >It steps in <em>before</em> the order, not after the loss</span
            >
          </li>
          <li class="flex gap-3">
            <span class="text-emerald-600 font-bold">&check;</span><span
              >The whole loop: monitor · guard · journal · review</span
            >
          </li>
        </ul>
        <p class="mt-5 text-sm text-emerald-700 font-medium">Guard adds the enforcement layer on top.</p>
      </div>
    </div>
  </section>

  <!-- ───────────────────────── RISK REVERSAL / REFUND ───────────────────────── -->
  <section class="border-y border-zinc-200 bg-white">
    <div class="max-w-5xl mx-auto px-6 py-24">
      <div data-reveal class="text-center mb-12">
        <p class="eyebrow text-[11px] font-bold text-emerald-700 mb-3">THE RISK IS OURS</p>
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-zinc-900">
          Try it on your own sessions, then decide.
        </h2>
        <p class="mt-4 text-lg text-zinc-600 max-w-2xl mx-auto leading-relaxed">
          You should not have to pay to find out whether a tool works for you &mdash; so you don't.
        </p>
      </div>
      <div data-reveal class="grid md:grid-cols-3 gap-5 max-w-4xl mx-auto">
        <div class="rounded-2xl border border-zinc-200 bg-[#fafafa] p-7">
          <div class="font-semibold text-zinc-900 mb-2">Guard, 7 days on the house</div>
          <p class="text-sm text-zinc-600 leading-relaxed">
            On NinjaTrader 8, your first 7 days on a free license include Guard. No card. Keep it after that for ${
              usd(guard.price)
            } a month.
          </p>
        </div>
        <div class="rounded-2xl border border-zinc-200 bg-[#fafafa] p-7">
          <div class="font-semibold text-zinc-900 mb-2">Cancel in two clicks</div>
          <p class="text-sm text-zinc-600 leading-relaxed">
            Manage Guard yourself through Whop, any time. Cancel and you keep it through the period you have already
            paid for.
          </p>
        </div>
        <div class="rounded-2xl border border-zinc-200 bg-[#fafafa] p-7">
          <div class="font-semibold text-zinc-900 mb-2">An honest refund</div>
          <p class="text-sm text-zinc-600 leading-relaxed">
            If Meridian won't run on a supported NinjaTrader 8 setup and we can't fix it, we refund you in full. Email <a
              href="mailto:contactmeridianpsi@gmail.com"
              class="underline text-emerald-800 hover:text-emerald-900">contactmeridianpsi@gmail.com</a
            >.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────────────────── FAQ ───────────────────────── -->
  <section class="max-w-3xl mx-auto px-6 py-24">
    <div data-reveal class="text-center mb-12">
      <p class="eyebrow text-[11px] font-bold text-emerald-700 mb-3">BEFORE YOU CHECK OUT</p>
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-zinc-900">Straight answers.</h2>
    </div>
    <!-- Collapsed accordions (same pattern as /faq): a buyer scans ten
         questions in one screen and opens only what they care about. The
         answers stay in the DOM, so the FAQPage schema and crawlers see
         everything. -->
    <div data-reveal class="rounded-2xl border border-zinc-200 bg-white overflow-hidden divide-y divide-zinc-100">
      {
        faqs.map((item) => (
          <details class="group">
            <summary class="flex items-center justify-between gap-4 px-6 py-4 cursor-pointer hover:bg-zinc-50 transition-colors list-none">
              <h3 class="font-semibold text-zinc-900 text-[15px]">{item.q}</h3>
              <svg
                class="w-4 h-4 text-zinc-400 shrink-0 transition-transform group-open:rotate-180"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="px-6 pb-5 -mt-1 text-zinc-600 leading-relaxed text-[15px]">{item.a}</p>
          </details>
        ))
      }
    </div>

    <!-- Billing terms (verbatim footnote) -->
    <p class="mt-12 text-center text-xs text-zinc-500 leading-relaxed max-w-2xl mx-auto">
      {footnote}
      <a href="/disclaimer" class="underline text-emerald-800 hover:text-emerald-900"> Risk disclaimer</a>.
    </p>
  </section>

  <!-- ───────────────────────── FINAL CTA ───────────────────────── -->
  <section class="border-y border-zinc-200 bg-white">
    <div data-reveal class="max-w-3xl mx-auto px-6 py-24 text-center">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-zinc-900 leading-[1.08]">
        Start free. Let your own data decide.
      </h2>
      <p class="mt-5 text-lg text-zinc-600">
        Core free, no card &middot; Guard ${usd(guard.price)}/mo, cancel anytime.
      </p>
      <p class="mt-3 text-sm text-zinc-500">
        Do the math: a single evaluation reset runs $100+, and one tilted session usually costs more than a month of
        Guard.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href={core.ctaHref}
          target="_blank"
          rel="noopener"
          class="font-semibold text-white bg-emerald-600 hover:bg-emerald-700 px-8 py-4 rounded-xl text-lg transition shadow-sm"
          >{core.ctaText}</a
        >
        <a
          href="/download#requirements"
          class="font-semibold text-zinc-800 bg-white border border-zinc-300 hover:border-zinc-400 px-8 py-4 rounded-xl text-lg transition"
          >System requirements</a
        >
      </div>
      <p class="mt-5 text-xs text-zinc-500 max-w-xl mx-auto leading-relaxed">
        Native in NinjaTrader 8 today &middot; Tradovate &amp; Ironbeam apps in early access. Trading involves
        substantial risk of loss. Meridian does not provide trading signals or investment advice.
      </p>
    </div>
  </section>
</Layout>
